<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Team1Abr.Web</RootNamespace>
    <AssemblyName>Team1Abr.Web</AssemblyName>

    <!-- Mobile performance: drop the ICU globalization data (~1.4 MB, ~340 KB
         compressed) from the WASM download. Safe here because all string
         comparisons are Ordinal/OrdinalIgnoreCase and there is no culture-
         sensitive number/date formatting. Biggest single first-load win on a
         mobile connection. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Team1Abr.Core.csproj" />
  </ItemGroup>

</Project>
