@using Team1Abr.Core

@*
    Accessible ABN lookup.

    Accessibility notes (WCAG 2.2 AA) addressed here:
    - The input has an associated, visible <label> (1.3.1 / 3.3.2).
    - Errors use role="alert" and aria-describedby so they are announced (4.1.3 / 3.3.1).
    - Results are placed in an aria-live region so screen readers hear the update (4.1.3).
    - Real <form> and <button> elements → full keyboard support (2.1.1).
    - aria-invalid is toggled on the field when there's an error (4.1.2).
    - First-load instructions are visible before any search (Story 8).
    - Loading and empty states are announced using role="status" (Story 8).

    Residual risks to verify with the Playwright accessibility checks + a keyboard walkthrough:
    colour contrast of the theme, and focus-visible styling (see wwwroot/styles.css).
*@

<section aria-labelledby="lookup-heading">
    <h2 id="lookup-heading">Look up an ABN</h2>

    <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
        <div class="field">
            <label for="abn-input">Australian Business Number (ABN)</label>
            <p id="abn-hint" class="hint">
                Enter the 11-digit ABN. Spaces are allowed.
            </p>
            <input id="abn-input"
                   name="abn"
                   type="text"
                   inputmode="numeric"
                   placeholder="e.g. 12 345 678 901"
                   autocomplete="off"
                   value="@_abnInput"
                   @oninput="OnInput"
                   aria-describedby="@(HasError ? "abn-hint abn-error" : "abn-hint")"
                   aria-invalid="@(HasError ? "true" : "false")" />
        </div>

        @if (HasError)
        {
            <p id="abn-error" role="alert" class="error">@_errorMessage</p>
        }

        <button type="submit" disabled="@_isLoading">@(_isLoading ? "Searching…" : "Search")</button>
    </form>

    @if (_recentSearches.Count > 0)
    {
        <section aria-labelledby="recent-searches-heading" class="recent-searches">
            <div class="recent-searches__header">
                <h3 id="recent-searches-heading">Recent searches</h3>
                <button type="button" @onclick="ClearRecentSearches">Clear</button>
            </div>
            <ul>
                @foreach (var recentSearch in _recentSearches)
                {
                    <li>
                        <button type="button" @onclick="() => HandleRecentSearch(recentSearch)">
                            @Abn.Format(recentSearch)
                        </button>
                    </li>
                }
            </ul>
        </section>
    }

    <div aria-live="polite" aria-atomic="true" class="results results--stable">
        @if (!_hasSearched)
        {
            <p class="results-message">
                Enter an 11-digit ABN, then select <strong>Search</strong> to view business details from the sample data.
            </p>
        }
        else if (_isLoading)
        {
            <p role="status" class="results-status">Searching sample data…</p>
        }
        else if (_state == LookupStatus.Found && _record is not null)
        {
            <article class="result-card" aria-label="Search result">
                <div class="result-card__header">
                    <h3>@_record.EntityName</h3>
                    <button type="button" @onclick="CopyAbnToClipboardAsync">Copy ABN</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_copyMessage))
                {
                    <p class="copy-message" aria-live="polite">@_copyMessage</p>
                }
                <dl>
                    <dt>ABN</dt>
                    <dd>@Abn.Format(_record.Abn)</dd>
                    <dt>Status</dt>
                    @* Status is conveyed by text, not colour alone (WCAG 1.4.1). *@
                    <dd>
                        <span class="@(_record.AbnStatus == "Active" ? "status status--active" : "status status--cancelled")">
                            @_record.AbnStatus
                        </span>
                    </dd>
                    <dt>Entity type</dt>
                    <dd>@_record.EntityType</dd>
                    <dt>Location</dt>
                    <dd>@_record.State @_record.Postcode</dd>
                    <dt>GST registered</dt>
                    <dd>@(_record.GstRegistered ? "Yes" : "No")</dd>
                </dl>
                <div class="summary">
                    <h4>Summary</h4>
                    <p>@Summary.Generate(_record)</p>
                    <p class="summary__note">Automatically generated from ABR sample data.</p>
                </div>
            </article>
        }
        else if (_state == LookupStatus.NotFound)
        {
            <p role="status" class="results-status">
                No business found for ABN <strong>@_notFoundAbn</strong> in the sample data.
            </p>
        }
    </div>
</section>
