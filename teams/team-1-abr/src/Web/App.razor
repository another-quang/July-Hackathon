@* Root component — composes the accessible ABN lookup feature.
   Kept intentionally simple (no router): this is a single-page demo. *@

<header>
    <div class="container header-content">
        <div class="header-branding">
            <img class="government-logo" src="OIP.jpg" alt="Australian Government crest"
                 width="56" height="56" decoding="async" fetchpriority="low" />
        </div>
        <div>
            <h1>ABN Lookup</h1>
            <p class="tagline">
                An accessible companion demo — GitHub Copilot Hackathon, Team 1.
            </p>
        </div>
    </div>
</header>

<main class="container" id="main">
    <AbnLookup />
    <BusinessBrowser />
</main>

<footer class="container">
    <p>
        Sample data only. This demo does not contact the live Australian
        Business Register.
    </p>
</footer>
